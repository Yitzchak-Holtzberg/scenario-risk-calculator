# --- Data (large, downloaded from external sources) -----------------------
data/raw/
data/model/
data/*.duckdb
data/*.duckdb.wal
*.csv
*.parquet
!projects/*/artifacts/**/*.csv
!projects/*/artifacts/**/*.parquet
# Hand-curated supplement values (IMF inflation, Hanke estimates) - tracked
!data/curated/**/*.csv
# Project-specific hand-curated labels - tracked
!projects/*/curated/**/*.csv
# Project model outputs (fitted RDS etc.) - rebuildable
projects/*/model/

# --- Go (projects/*/api/) --------------------------------------------------
projects/*/api/bin/
projects/*/api/*.exe
projects/*/api/*.test
projects/*/api/vendor/

# --- Node / SvelteKit (projects/*/web/) ------------------------------------
projects/*/web/node_modules/
projects/*/web/.svelte-kit/
projects/*/web/build/
projects/*/web/.env
projects/*/web/.env.*
!projects/*/web/.env.example
# Note: projects/*/web/artifacts/ is committed (duplicate of the project's
# artifacts/) so GitHub Pages can serve the dashboard as a self-contained dir.
# 12_export_artifacts syncs artifacts/*.json -> web/artifacts/.

# --- R + Quarto (pipelines/, projects/*/analysis/) -------------------------
.Rhistory
.RData
.Ruserdata
.Rproj.user/
renv/library/
renv/local/
renv/staging/
_freeze/
_site/
pipelines/*.html
projects/*/analysis/*.html
# Quarto auto-generated sibling directories (per-doc libs, figures, cache)
*_files/
*_cache/
.Renviron
*.Rcheck/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Secrets ---------------------------------------------------------------
*.key
*.pem
.env
.env.local
